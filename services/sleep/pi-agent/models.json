{
  "providers": {
    "local-glm": {
      "baseUrl": "http://127.0.0.1:8893/v1",
      "api": "openai-completions",
      "apiKey": "local-no-secret",
      "models": [{
        "id": "glm-5.3-flash-atlas",
        "name": "Local GLM sleep",
        "reasoning": true,
        "input": ["text", "image"],
        "contextWindow": 524288,
        "maxTokens": 8192,
        "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
        "compat": { "supportsReasoningEffort": false },
        "samplingParams": { "temperature": 0.7, "top_p": 1, "chat_template_kwargs": { "enable_thinking": true, "reasoning_effort": "high" } }
      }]
    }
  }
}
