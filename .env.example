# Sign-in password for the owner of this deployment.
OWNER_PASSWORD=
# OpenRouter (https://openrouter.ai/keys): perception, transcription, memory. Requests require zero data retention.
OPENROUTER_API_KEY=
# pyannoteAI (https://dashboard.pyannote.ai): who is speaking.
PYANNOTE_API_KEY=
# Set by the Neon integration on Vercel; for local development copy it from the Vercel project (vercel env pull).
DATABASE_URL=
# Optional: Better Auth's secret (otherwise generated into the database) and the public origin agents use.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Optional: the language observations are written in (default English).
MEMORY_LANGUAGE=
